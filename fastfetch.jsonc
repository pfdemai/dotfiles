{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "color": { "1": "#76838a", "2": "#76838a", "3": "#76838a" }
    },
    "display": {
        "color": { "keys": "#72a6bd", "title": "#d48b5c" }
    },
    "modules": [
        "title", "separator",
        "os", "host", "kernel", "uptime", "packages", "shell",
        "display", "de", "wm", "theme", "icons", "cursor",
        "terminal", "terminalfont",
        "cpu", "gpu", "memory", "swap", "disk",
        "localip", "locale",
        "break", "colors"
    ]
}
